---
import { cardVariants } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import Topbar from "@/components/Topbar.astro";
import { MESSAGES } from "@/lib/constants/messages";
---

<div class="relative min-h-screen w-full overflow-hidden">
  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="mb-6 text-foreground text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">
        {MESSAGES.APP_TITLE}
      </h1>
      <p class="mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">
        A TTRPG notepad that makes relations managing and data recall easy.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/auth/signin" class:list={cn(buttonVariants(), "h-auto rounded-lg px-6 py-3 text-base")}>
          Sign In
        </a>
        <a
          href="/auth/signup"
          class:list={cn(buttonVariants({ variant: "outline" }), "h-auto rounded-lg px-6 py-3 text-base")}
        >
          Sign Up
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class:list={cn(cardVariants(), "rounded-xl p-6")}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-primary"
          aria-hidden="true"
        >
          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
          <path d="m15 5 4 4"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-foreground">Make notes</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Note the NPC, note their quest and reference the NPC in the description.
        </p>
      </div>

      <div class:list={cn(cardVariants(), "rounded-xl p-6")}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-primary"
          aria-hidden="true"
        >
          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
          <path d="M21 3v5h-5"></path>
          <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
          <path d="M8 16H3v5"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-foreground">Keep noting</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">
          The references are updated automatically whenever you update, add or delete a note. Immediately.
        </p>
      </div>

      <div class:list={cn(cardVariants(), "rounded-xl p-6")}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mb-4 text-primary"
          aria-hidden="true"
        >
          <path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"></path>
          <path d="M15 5.764v15"></path>
          <path d="M9 3.236v15"></path>
        </svg>
        <h3 class="mb-2 text-lg font-semibold text-foreground">Recall</h3>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Find where Boblin the Goblin lived through the interactive memory map with search capability.
        </p>
      </div>
    </div>
  </div>
</div>
