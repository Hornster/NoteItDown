---
import { MESSAGES } from "@/lib/constants/messages";
import { createClient } from "@/lib/supabase";
import { listCampaigns } from "@/lib/services/campaigns";
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import CampaignSwitcher from "@/components/campaigns/CampaignSwitcher";
import type { CampaignView } from "@/lib/campaign-paths";
import type { CampaignSummary } from "@/types";

interface Props {
  campaignId?: string;
  view?: CampaignView;
}

const { campaignId, view = "none" } = Astro.props;
const { user } = Astro.locals;

const dashboardHref = campaignId ? `/campaigns/${campaignId}` : "/dashboard";
const mapHref = campaignId ? `/campaigns/${campaignId}/map` : "/map";

let campaigns: CampaignSummary[] = [];
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      campaigns = await listCampaigns(supabase);
    } catch (error) {
      // Topbar is navigation chrome: a failed lookup must not turn the whole page into a 500.
      // eslint-disable-next-line no-console -- surface the DB failure for operators; the switcher just renders empty.
      console.error("Topbar: listCampaigns failed", error);
    }
  }
}
---

<div
  class:list={cn(
    cardVariants(),
    "mb-4 flex flex-wrap items-center justify-between gap-2 rounded-xl px-4 py-2 text-sm text-foreground",
  )}
>
  {user ? (
    <>
      <span class="truncate text-muted-foreground">{user.email}</span>
      <div class="flex flex-wrap items-center gap-3">
        <CampaignSwitcher client:load campaigns={campaigns} campaignId={campaignId} view={view} />
        <a href="/campaigns/new" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          {MESSAGES.NEW_CAMPAIGN_LABEL}
        </a>
        <a href={dashboardHref} class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Dashboard
        </a>
        <a href={mapHref} class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Map
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-primary transition-colors hover:text-primary/80 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          {MESSAGES.SIGN_IN_LABEL}
        </a>
        <a href="/auth/signup" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          {MESSAGES.SIGN_UP_LABEL}
        </a>
      </div>
    </>
  )}
</div>
