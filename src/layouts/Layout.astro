---
import "../styles/global.css";
import { Font } from "astro:assets";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { MESSAGES } from "@/lib/constants/messages";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <Font cssVariable="--font-lora" preload={[{ weight: "400", style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-cinzel" />
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <footer class="bg-background border-t border-border px-4 py-6 text-center text-xs text-muted-foreground">
      <a href="/licenses" class="hover:underline">
        {MESSAGES.LICENSES_LABEL}
      </a>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
