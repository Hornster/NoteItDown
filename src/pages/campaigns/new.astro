---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CampaignForm from "@/components/campaigns/CampaignForm";
---

<Layout title={MESSAGES.NEW_CAMPAIGN_LABEL}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-lg">
      <Topbar view="none" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        <h1 class="mb-6 text-foreground text-2xl font-bold">{MESSAGES.NEW_CAMPAIGN_LABEL}</h1>
        <CampaignForm mode="create" client:load />
      </div>
    </div>
  </div>
</Layout>
