---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { HTTP_STATUS } from "@/lib/constants/http-status";
import { MESSAGES, renameCampaignTitle } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CampaignForm from "@/components/campaigns/CampaignForm";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { rememberCampaign } from "@/lib/campaign-cookie";
import type { Campaign } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see src/pages/notes/[id].astro).
const { campaignId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign: Campaign | null = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

if (!campaign) {
  Astro.response.status = HTTP_STATUS.NOT_FOUND;
} else {
  rememberCampaign(Astro.cookies, campaign.id);
}
---

<Layout title={campaign ? renameCampaignTitle(campaign.name) : MESSAGES.CAMPAIGN_NOT_FOUND_TITLE}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-lg">
      <Topbar campaignId={campaignId} view="edit" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        {campaign ? (
          <>
            <h1 class="mb-6 text-foreground text-2xl font-bold">{renameCampaignTitle(campaign.name)}</h1>
            <CampaignForm mode="rename" campaignId={campaign.id} initialName={campaign.name} client:load />
            <a
              href={`/campaigns/${campaign.id}`}
              class="mt-4 inline-block text-sm text-primary transition-colors hover:text-primary/80 hover:underline"
            >
              {MESSAGES.CANCEL_LABEL}
            </a>
          </>
        ) : (
          <p class="text-muted-foreground">{MESSAGES.CAMPAIGN_NOT_FOUND}</p>
        )}
      </div>
    </div>
  </div>
</Layout>
