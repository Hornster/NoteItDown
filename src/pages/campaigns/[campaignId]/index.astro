---
import { cardVariants } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { HTTP_STATUS } from "@/lib/constants/http-status";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { listNotes } from "@/lib/services/notes";
import NotesBrowser from "@/components/notes/NotesBrowser";
import { NOTE_SEARCH_PARAM, normalizeQuery } from "@/lib/note-search";
import RelationChangeNotice from "@/components/notes/RelationChangeNotice";
import { rememberCampaign } from "@/lib/campaign-cookie";
import type { NoteListItem } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see src/pages/notes/[id].astro).
const { campaignId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

const initialQuery = normalizeQuery(Astro.url.searchParams.get(NOTE_SEARCH_PARAM));

let notes: NoteListItem[] = [];
if (!campaign) {
  Astro.response.status = HTTP_STATUS.NOT_FOUND;
} else {
  rememberCampaign(Astro.cookies, campaign.id);
  if (supabase) {
    notes = await listNotes(supabase, campaign.id);
  }
}
---

<Layout title={campaign ? campaign.name : MESSAGES.CAMPAIGN_NOT_FOUND_TITLE}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar campaignId={campaignId} view="notes" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        {campaign ? (
          <>
            <div class="mb-6 flex items-center justify-between gap-4">
              <div class="flex min-w-0 flex-wrap items-baseline gap-2">
                <h1 class="text-foreground text-3xl font-bold">{campaign.name}</h1>
                <a
                  href={`/campaigns/${campaign.id}/edit`}
                  class="text-sm text-primary transition-colors hover:text-primary/80 hover:underline"
                >
                  Rename
                </a>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <a
                  href={`/campaigns/${campaign.id}/map`}
                  class:list={cn(buttonVariants({ variant: "outline" }), "rounded-lg px-4 py-2 text-sm")}
                >
                  {MESSAGES.MEMORY_MAP_LABEL}
                </a>
                <a
                  href={`/campaigns/${campaign.id}/notes/new`}
                  class:list={cn(buttonVariants(), "rounded-lg px-4 py-2 text-sm")}
                >
                  {MESSAGES.NEW_NOTE_LABEL}
                </a>
              </div>
            </div>

            <RelationChangeNotice
              client:load
              campaignId={campaign.id}
              target={{ kind: "delete", campaignId: campaign.id }}
            />

            {notes.length === 0 ? (
              <div class="rounded-xl border border-dashed border-input bg-background p-8 text-center">
                <p class="text-muted-foreground">{MESSAGES.NOTES_EMPTY}</p>
                <a
                  href={`/campaigns/${campaign.id}/notes/new`}
                  class:list={cn(buttonVariants(), "mt-3 inline-block rounded-lg px-4 py-2 text-sm")}
                >
                  {MESSAGES.NOTES_EMPTY_CTA}
                </a>
              </div>
            ) : (
              <NotesBrowser client:load campaignId={campaign.id} notes={notes} initialQuery={initialQuery} />
            )}
          </>
        ) : (
          <p class="text-muted-foreground">{MESSAGES.CAMPAIGN_NOT_FOUND}</p>
        )}
      </div>
    </div>
  </div>
</Layout>
