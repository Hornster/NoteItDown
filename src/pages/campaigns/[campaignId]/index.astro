---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { listNotes } from "@/lib/services/notes";
import RelationChangeNotice from "@/components/notes/RelationChangeNotice";
import { rememberCampaign } from "@/lib/campaign-cookie";
import type { NoteListItem } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see src/pages/notes/[id].astro).
const { campaignId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

let notes: NoteListItem[] = [];
if (!campaign) {
  Astro.response.status = 404;
} else {
  rememberCampaign(Astro.cookies, campaign.id);
  if (supabase) {
    notes = await listNotes(supabase, campaign.id);
  }
}
---

<Layout title={campaign ? campaign.name : "Campaign not found"}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar campaignId={campaignId} view="notes" />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        {campaign ? (
          <>
            <div class="mb-6 flex items-center justify-between gap-4">
              <div class="flex min-w-0 flex-wrap items-baseline gap-2">
                <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                  {campaign.name}
                </h1>
                <a
                  href={`/campaigns/${campaign.id}/edit`}
                  class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                >
                  Rename
                </a>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <a
                  href={`/campaigns/${campaign.id}/map`}
                  class="rounded-lg border border-white/20 px-4 py-2 text-sm font-medium text-white/90 transition-colors hover:bg-white/10"
                >
                  Memory map
                </a>
                <a
                  href={`/campaigns/${campaign.id}/notes/new`}
                  class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                >
                  New note
                </a>
              </div>
            </div>

            <RelationChangeNotice
              client:load
              campaignId={campaign.id}
              target={{ kind: "delete", campaignId: campaign.id }}
            />

            {notes.length === 0 ? (
              <div class="rounded-xl border border-dashed border-white/20 bg-white/5 p-8 text-center">
                <p class="text-blue-100/70">No notes yet.</p>
                <a
                  href={`/campaigns/${campaign.id}/notes/new`}
                  class="mt-3 inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                >
                  Create your first note
                </a>
              </div>
            ) : (
              <ul class="space-y-2">
                {notes.map((note) => (
                  <li>
                    <a
                      href={`/campaigns/${campaign.id}/notes/${note.id}`}
                      class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 transition-colors hover:bg-white/10"
                    >
                      <span class="truncate font-medium text-white">{note.name}</span>
                      <span class="shrink-0 rounded-full bg-purple-500/30 px-2.5 py-1 text-xs text-purple-200">
                        {note.type_name}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <p class="text-blue-100/70">This campaign doesn't exist or isn't yours.</p>
        )}
      </div>
    </div>
  </div>
</Layout>
