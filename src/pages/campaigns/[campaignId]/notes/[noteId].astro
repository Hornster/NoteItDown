---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { getNote } from "@/lib/services/notes";
import { countNoteRelations } from "@/lib/services/relations";
import { listNoteImages, toImageViews } from "@/lib/services/note-images";
import { isUuid } from "@/lib/utils";
import RelationChangeNotice from "@/components/notes/RelationChangeNotice";
import DeleteNoteButton from "@/components/notes/DeleteNoteButton";
import NoteImages from "@/components/notes/NoteImages";
import { rememberCampaign } from "@/lib/campaign-cookie";
import { MESSAGES } from "@/lib/messages";
import type { NoteDetail, NoteImageView } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see the additional guidance in context/changes/create-notes/plan.md).
const { campaignId, noteId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

let note: NoteDetail | null = null;
let relationCount = 0;
let images: NoteImageView[] = [];
let imagesUnavailable = false;
if (!campaign) {
  Astro.response.status = 404;
} else {
  rememberCampaign(Astro.cookies, campaign.id);

  const noteIdIsValid = typeof noteId === "string" && isUuid(noteId);
  // RLS makes another tenant's note come back as null too, so this also 404s for it.
  const found = noteIdIsValid && supabase ? await getNote(supabase, noteId) : null;
  note = found?.campaign_id === campaign.id ? found : null;

  if (!note) {
    Astro.response.status = 404;
  } else if (supabase) {
    relationCount = await countNoteRelations(supabase, note.id);
    try {
      images = await toImageViews(supabase, await listNoteImages(supabase, note.id));
    } catch (error) {
      // An image-table failure must not block reading the note's text.
      // eslint-disable-next-line no-console -- surface unexpected failures for operators; the user sees a notice.
      console.error("note page: loading note images failed", error);
      imagesUnavailable = true;
    }
  }
}
---

<Layout title={note ? note.name : "Note not found"}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar campaignId={campaignId} view="note" />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        {campaign && (
          <a
            href={`/campaigns/${campaign.id}`}
            class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
          >
            &larr; Back to {campaign.name}
          </a>
        )}

        {note ? (
          <>
            <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-3">
              <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                {note.name}
              </h1>
              <div class="flex shrink-0 items-center gap-3">
                <a
                  href={`/campaigns/${note.campaign_id}/notes/${note.id}/edit`}
                  class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
                >
                  Edit
                </a>
                <DeleteNoteButton
                  client:load
                  campaignId={note.campaign_id}
                  noteId={note.id}
                  noteName={note.name}
                  relationCount={relationCount}
                />
                <span class="rounded-full bg-purple-500/30 px-2.5 py-1 text-xs text-purple-200">{note.type_name}</span>
              </div>
            </div>

            <RelationChangeNotice
              client:load
              campaignId={note.campaign_id}
              target={{ kind: "edit", noteId: note.id }}
            />

            <div class="rounded-xl border border-white/10 bg-white/5 p-4 whitespace-pre-wrap text-blue-100/90">
              {note.content}
            </div>

            {images.length > 0 && (
              <NoteImages
                client:load
                campaignId={note.campaign_id}
                noteId={note.id}
                noteName={note.name}
                images={images}
              />
            )}
            {imagesUnavailable && <p class="mt-6 text-sm text-amber-200">{MESSAGES.NOTE_IMAGES_LOAD_FAILED}</p>}
          </>
        ) : (
          <p class="mt-4 text-blue-100/70">This note doesn't exist or isn't yours.</p>
        )}
      </div>
    </div>
  </div>
</Layout>
