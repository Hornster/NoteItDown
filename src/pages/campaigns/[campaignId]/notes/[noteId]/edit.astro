---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { HTTP_STATUS } from "@/lib/constants/http-status";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import NoteForm from "@/components/notes/NoteForm";
import ImageFailureNotice from "@/components/notes/ImageFailureNotice";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { getNote, listNoteTypes } from "@/lib/services/notes";
import { listNoteImages, toImageViews } from "@/lib/services/note-images";
import { isUuid } from "@/lib/utils";
import { rememberCampaign } from "@/lib/campaign-cookie";
import type { NoteDetail, NoteImageView, NoteType } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see ../[noteId].astro).
const { campaignId, noteId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

let note: NoteDetail | null = null;
let noteTypes: NoteType[] = [];
let images: NoteImageView[] = [];
let imagesUnavailable = false;
if (!campaign) {
  Astro.response.status = HTTP_STATUS.NOT_FOUND;
} else {
  rememberCampaign(Astro.cookies, campaign.id);

  const noteIdIsValid = typeof noteId === "string" && isUuid(noteId);
  // RLS makes another tenant's note come back as null too, so this also 404s for it.
  const found = noteIdIsValid && supabase ? await getNote(supabase, noteId) : null;
  note = found?.campaign_id === campaign.id ? found : null;

  if (!note) {
    Astro.response.status = HTTP_STATUS.NOT_FOUND;
  } else if (supabase) {
    noteTypes = await listNoteTypes(supabase, campaign.id);
    try {
      images = await toImageViews(supabase, await listNoteImages(supabase, note.id));
    } catch (error) {
      // An image-table failure must not block editing the note's text.
      // eslint-disable-next-line no-console -- surface unexpected failures for operators; the user sees a banner.
      console.error("edit page: loading note images failed", error);
      imagesUnavailable = true;
    }
  }
}
---

<Layout title={note ? `Edit ${note.name}` : MESSAGES.NOTE_NOT_FOUND_TITLE}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-lg">
      <Topbar campaignId={campaignId} view="note" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        {campaign && note ? (
          <>
            <h1 class="mb-6 text-foreground text-2xl font-bold">Edit note</h1>
            <ImageFailureNotice noteId={note.id} client:load />
            <NoteForm
              mode="edit"
              campaignId={campaign.id}
              noteTypes={noteTypes}
              note={{ id: note.id, name: note.name, content: note.content, type_id: note.type_id }}
              images={imagesUnavailable ? null : images}
              client:load
            />
            <a
              href={`/campaigns/${campaign.id}/notes/${note.id}`}
              class="mt-4 inline-block text-sm text-primary transition-colors hover:text-primary/80 hover:underline"
            >
              {MESSAGES.CANCEL_LABEL}
            </a>
          </>
        ) : (
          <p class="text-muted-foreground">{MESSAGES.NOTE_NOT_FOUND}</p>
        )}
      </div>
    </div>
  </div>
</Layout>
