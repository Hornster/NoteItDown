---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { HTTP_STATUS } from "@/lib/constants/http-status";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import NoteForm from "@/components/notes/NoteForm";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { listNoteTypes } from "@/lib/services/notes";
import { rememberCampaign } from "@/lib/campaign-cookie";
import type { NoteType } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see the additional guidance in context/changes/create-notes/plan.md).
const { campaignId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

let noteTypes: NoteType[] = [];
if (!campaign) {
  Astro.response.status = HTTP_STATUS.NOT_FOUND;
} else {
  rememberCampaign(Astro.cookies, campaign.id);
  if (supabase) {
    noteTypes = await listNoteTypes(supabase, campaign.id);
  }
}
---

<Layout title={MESSAGES.NEW_NOTE_LABEL}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-lg">
      <Topbar campaignId={campaignId} view="new-note" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        <h1 class="mb-6 text-foreground text-2xl font-bold">{MESSAGES.NEW_NOTE_LABEL}</h1>
        {campaign ? (
          <NoteForm mode="create" campaignId={campaign.id} noteTypes={noteTypes} client:load />
        ) : (
          <p class="text-muted-foreground">{MESSAGES.CAMPAIGN_NOT_FOUND}</p>
        )}
      </div>
    </div>
  </div>
</Layout>
