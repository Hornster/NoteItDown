---
import { cardVariants } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { HTTP_STATUS } from "@/lib/constants/http-status";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MemoryMap from "@/components/memory-map/MemoryMap";
import { createClient } from "@/lib/supabase";
import { getCampaign } from "@/lib/services/campaigns";
import { listNotes } from "@/lib/services/notes";
import { listRelations } from "@/lib/services/relations";
import { rememberCampaign } from "@/lib/campaign-cookie";
import { NOTE_SEARCH_PARAM, normalizeQuery } from "@/lib/note-search";
import type { MemoryMapRelation, NoteListItem } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use conditional rendering instead (see
// src/pages/notes/[id].astro).
const { campaignId } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = campaignId && supabase ? await getCampaign(supabase, campaignId) : null;

const initialQuery = normalizeQuery(Astro.url.searchParams.get(NOTE_SEARCH_PARAM));

let notes: NoteListItem[] = [];
let relations: MemoryMapRelation[] = [];
if (!campaign) {
  Astro.response.status = HTTP_STATUS.NOT_FOUND;
} else {
  rememberCampaign(Astro.cookies, campaign.id);
  if (supabase) {
    [notes, relations] = await Promise.all([listNotes(supabase, campaign.id), listRelations(supabase, campaign.id)]);
  }
}
---

<Layout title={MESSAGES.MEMORY_MAP_LABEL}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-6xl">
      <Topbar campaignId={campaignId} view="map" />
      <div class:list={cn(cardVariants(), "rounded-2xl p-8")}>
        {campaign ? (
          <>
            <h1 class="mb-2 text-foreground text-3xl font-bold">
              {campaign.name} &mdash; {MESSAGES.MEMORY_MAP_LABEL}
            </h1>
            <p class="mb-6 text-sm text-muted-foreground">
              Click a note to open it. Connections are detected automatically when a note's text mentions another note's
              exact name.
            </p>

            {notes.length === 0 ? (
              <div class="rounded-xl border border-dashed border-input bg-background p-8 text-center">
                <p class="text-muted-foreground">{MESSAGES.NOTES_EMPTY}</p>
                <a
                  href={`/campaigns/${campaign.id}/notes/new`}
                  class:list={cn(buttonVariants(), "mt-3 inline-block rounded-lg px-4 py-2 text-sm")}
                >
                  {MESSAGES.NOTES_EMPTY_CTA}
                </a>
              </div>
            ) : (
              <>
                {relations.length === 0 && (
                  <p class="mb-3 text-xs text-muted-foreground">
                    No connections yet. A connection appears once a note's text mentions another note's exact name.
                  </p>
                )}
                <MemoryMap
                  client:only="react"
                  campaignId={campaign.id}
                  notes={notes}
                  relations={relations}
                  initialQuery={initialQuery}
                >
                  <div
                    slot="fallback"
                    class="flex h-[70vh] items-center justify-center overflow-hidden rounded-xl border border-input bg-background text-muted-foreground"
                  >
                    Loading map&hellip;
                  </div>
                </MemoryMap>
              </>
            )}
          </>
        ) : (
          <p class="text-muted-foreground">{MESSAGES.CAMPAIGN_NOT_FOUND}</p>
        )}
      </div>
    </div>
  </div>
</Layout>
