---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import lgplText from "@/assets/licenses/lgpl-3.0.txt?raw";
import gplText from "@/assets/licenses/gpl-3.0.txt?raw";
import oflText from "@/assets/licenses/ofl-1.1.txt?raw";

export const prerender = false;

const notices = [
  {
    name: "heic-to",
    version: "1.6.5",
    license: "LGPL-3.0",
    copyright: "© Hopper Gee",
    source: "https://github.com/hoppergee/heic-to",
  },
  {
    name: "libheif",
    version: "1.23.5",
    license: "LGPL-3.0",
    copyright: "© Dirk Farin / struktur AG",
    source: "https://github.com/strukturag/libheif",
  },
  {
    name: "libde265",
    version: "1.0.16",
    license: "LGPL-3.0",
    copyright: "© struktur AG, Dirk Farin",
    source: "https://github.com/strukturag/libde265",
  },
];

const fontNotices = [
  {
    name: "Cinzel",
    license: "OFL-1.1",
    copyright: "© 2020 The Cinzel Project Authors",
    source: "https://github.com/NDISCOVER/Cinzel",
  },
  {
    name: "Lora",
    license: "OFL-1.1",
    copyright: '© 2011 The Lora Project Authors, with Reserved Font Name "Lora"',
    source: "https://github.com/cyrealtype/Lora-Cyrillic",
  },
];
---

<Layout title={MESSAGES.LICENSES_LABEL}>
  <div class="min-h-screen p-4 text-foreground">
    <div class="mx-auto max-w-3xl py-8">
      <h1 class="mb-2 text-foreground text-2xl font-bold">{MESSAGES.LICENSES_LABEL}</h1>
      <p class="mb-6 text-sm text-muted-foreground">
        HEIC photos are converted in your browser with the libraries below, loaded only when you pick a HEIC file. They
        are used unmodified and are distributed under the GNU Lesser General Public License v3.0, which incorporates the
        GNU General Public License v3.0.
      </p>

      <ul class="mb-8 space-y-3">
        {notices.map((n) => (
          <li class:list={cn(cardVariants(), "rounded-2xl p-4")}>
            <p class="font-semibold">
              {n.name} <span class="text-muted-foreground">{n.version}</span>
            </p>
            <p class="text-sm text-muted-foreground">
              {n.license} &middot; {n.copyright}
            </p>
            <a href={n.source} target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline">
              {n.source}
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mb-2 text-lg font-semibold">Fonts</h2>
      <p class="mb-4 text-sm text-muted-foreground">
        The Cinzel and Lora typefaces are self-hosted and distributed under the SIL Open Font License 1.1.
      </p>
      <ul class="mb-8 space-y-3">
        {fontNotices.map((n) => (
          <li class:list={cn(cardVariants(), "rounded-2xl p-4")}>
            <p class="font-semibold">{n.name}</p>
            <p class="text-sm text-muted-foreground">
              {n.license} &middot; {n.copyright}
            </p>
            <a href={n.source} target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline">
              {n.source}
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mb-2 text-lg font-semibold">GNU Lesser General Public License v3.0</h2>
      <pre
        class:list={cn(
          cardVariants(),
          "mb-8 overflow-x-auto rounded-2xl p-4 text-xs whitespace-pre-wrap text-foreground",
        )}
      >{lgplText}</pre>

      <h2 class="mb-2 text-lg font-semibold">GNU General Public License v3.0</h2>
      <pre
        class:list={cn(cardVariants(), "overflow-x-auto rounded-2xl p-4 text-xs whitespace-pre-wrap text-foreground")}
      >{gplText}</pre>

      <h2 class="mt-8 mb-2 text-lg font-semibold">SIL Open Font License 1.1</h2>
      <pre
        class:list={cn(cardVariants(), "overflow-x-auto rounded-2xl p-4 text-xs whitespace-pre-wrap text-foreground")}
      >{oflText}</pre>
    </div>
  </div>
</Layout>
