---
import { cardVariants } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { MESSAGES } from "@/lib/constants/messages";
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title={MESSAGES.SIGN_IN_LABEL}>
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class:list={cn(cardVariants(), "w-full max-w-sm rounded-2xl p-8")}>
      <h1 class="mb-6 text-foreground text-center text-2xl font-bold">{MESSAGES.SIGN_IN_LABEL}</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Don't have an account?{" "}
        <a href="/auth/signup" class="text-primary underline underline-offset-4 hover:text-primary/80">
          {MESSAGES.SIGN_UP_LABEL}
        </a>
      </p>
    </div>
  </div>
</Layout>
