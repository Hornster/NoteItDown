---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MemoryMap from "@/components/memory-map/MemoryMap";
import { createClient } from "@/lib/supabase";
import { getActiveCampaign } from "@/lib/services/campaigns";
import { listNotes } from "@/lib/services/notes";
import { listRelations } from "@/lib/services/relations";
import type { MemoryMapRelation, NoteListItem } from "@/types";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use conditional rendering instead (see
// src/pages/notes/[id].astro).
const supabase = createClient(Astro.request.headers, Astro.cookies);
const campaign = supabase ? await getActiveCampaign(supabase) : null;
const notes: NoteListItem[] = campaign && supabase ? await listNotes(supabase, campaign.id) : [];
const relations: MemoryMapRelation[] = campaign && supabase ? await listRelations(supabase, campaign.id) : [];
---

<Layout title="Memory map">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-6xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        {campaign ? (
          <>
            <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              {campaign.name} &mdash; Memory map
            </h1>
            <p class="mb-6 text-sm text-blue-100/70">
              Click a note to open it. Connections are detected automatically when a note's text mentions another note's
              exact name.
            </p>

            {notes.length === 0 ? (
              <div class="rounded-xl border border-dashed border-white/20 bg-white/5 p-8 text-center">
                <p class="text-blue-100/70">No notes yet.</p>
                <a
                  href="/notes/new"
                  class="mt-3 inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                >
                  Create your first note
                </a>
              </div>
            ) : (
              <>
                {relations.length === 0 && (
                  <p class="mb-3 text-xs text-blue-100/60">
                    No connections yet. A connection appears once a note's text mentions another note's exact name.
                  </p>
                )}
                <div class="h-[70vh] overflow-hidden rounded-xl border border-white/10 bg-white/5">
                  <MemoryMap client:only="react" notes={notes} relations={relations}>
                    <div slot="fallback" class="flex h-full items-center justify-center text-blue-100/70">
                      Loading map&hellip;
                    </div>
                  </MemoryMap>
                </div>
              </>
            )}
          </>
        ) : (
          <p class="text-blue-100/70">No campaign found for this account.</p>
        )}
      </div>
    </div>
  </div>
</Layout>
