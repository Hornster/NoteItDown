---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { getNote } from "@/lib/services/notes";

// A top-level `return` in Astro frontmatter crashes this project's ESLint
// (@typescript-eslint/no-misused-promises); use Astro.response.status + conditional
// rendering instead (see the additional guidance in context/changes/create-notes/plan.md).
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const { id } = Astro.params;
const idIsValid = typeof id === "string" && UUID_RE.test(id);

const supabase = createClient(Astro.request.headers, Astro.cookies);
// RLS makes another tenant's note come back as null too, so this also 404s for it.
const note = idIsValid && supabase ? await getNote(supabase, id) : null;

if (!note) {
  Astro.response.status = 404;
}
---

<Layout title={note ? note.name : "Note not found"}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <a href="/dashboard" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          &larr; Back to notes
        </a>

        {note ? (
          <>
            <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-3">
              <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                {note.name}
              </h1>
              <span class="shrink-0 rounded-full bg-purple-500/30 px-2.5 py-1 text-xs text-purple-200">
                {note.type_name}
              </span>
            </div>

            <div class="rounded-xl border border-white/10 bg-white/5 p-4 whitespace-pre-wrap text-blue-100/90">
              {note.content}
            </div>
          </>
        ) : (
          <p class="mt-4 text-blue-100/70">This note doesn't exist or isn't yours.</p>
        )}
      </div>
    </div>
  </div>
</Layout>
